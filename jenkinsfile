// -------------------------------------------------------------------------
// ADVANCED PIPELINE: Demonstrating Cross-Node Remoting, Stashing, 
// Dynamic Parallelism, and Groovy Scripting in Jenkins.
// -------------------------------------------------------------------------

// 1. Helper function (DRY Principle - Don't Repeat Yourself)
def logCustomStep(String stepName, String message) {
    echo ">>> [${stepName}] : ${message} <<<"
}

pipeline {
    // We execute stages only on designated nodes to save controller resources
    agent none 
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timestamps()
        // Aggressive timeout to prevent hanging builds
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['DEV', 'STAGING', 'PROD'], description: 'Deployment Environment')
        booleanParam(name: 'RUN_FULL_SUITE', defaultValue: true, description: 'Execute comprehensive dynamic testing')
    }
    
    environment {
        // Global variables available to all nodes and stages
        PROJECT_CODENAME = 'Antigravity-Remoting'
    }
    
    stages {
        stage('Cross-Node Initialization') {
            parallel {
                stage('Init Linux') {
                    agent { label 'linux' }
                    steps {
                        deleteDir()
                        script {
                            logCustomStep("Linux Init", "Workspace safely wiped on Linux node.")
                        }
                    }
                }
                stage('Init Windows') {
                    agent { label 'windows' }
                    steps {
                        deleteDir()
                        script {
                            logCustomStep("Windows Init", "Workspace safely wiped on Windows node.")
                        }
                    }
                }
            }
        }
        
        stage('Distributed Build & Data Transfer') {
            // This stage demonstrates generating data on Windows, passing it 
            // securely through the Jenkins Controller, and consuming it on Linux.
            // This is the ultimate demonstration of Jenkins Remoting capabilities!
            stages {
                stage('Compile Core (Windows)') {
                    agent { label 'windows' }
                    steps {
                        bat 'echo "Compiling Core Engine on Windows Architecture..."'
                        bat 'echo "Windows_Core_Compiled_Successfully" > windows_core.dat'
                        
                        // STASH: Save the file from the Windows node into the Jenkins Controller memory
                        stash name: 'windows_payload', includes: 'windows_core.dat'
                        
                        script { logCustomStep("Windows Build", "Core dat file stashed securely to Controller.") }
                    }
                }
                
                stage('Assemble & Package (Linux)') {
                    agent { label 'linux' }
                    steps {
                        sh 'echo "Assembling Final Package on Linux Architecture..."'
                        
                        // UNSTASH: Pull the file that was generated on Windows onto the Linux node!
                        unstash 'windows_payload'
                        
                        // Prove that we successfully transferred the Windows data
                        sh 'echo "Content received from Windows:"'
                        sh 'cat windows_core.dat'
                        
                        // Merge it into a final artifact
                        sh 'echo "- Linux_Wrapper_Added" >> windows_core.dat'
                        sh 'cp windows_core.dat final_release_package.txt'
                        
                        // Securely archive the merged artifact
                        archiveArtifacts artifacts: 'final_release_package.txt', fingerprint: true
                        
                        script { logCustomStep("Linux Package", "Successfully merged Windows payload with Linux data and archived.") }
                    }
                }
            }
        }
        
        stage('Dynamic Parallel Testing') {
            when {
                expression { params.RUN_FULL_SUITE == true }
            }
            agent { label 'linux' }
            steps {
                script {
                    // Demonstrating Groovy scripting to dynamically generate parallel stages on the fly!
                    def testTypes = ['Security', 'Integration', 'Performance']
                    def parallelTasks = [:]
                    
                    for (int i = 0; i < testTypes.size(); i++) {
                        // Must bind the variable locally inside the loop for Groovy closures
                        def testName = testTypes[i] 
                        parallelTasks[testName] = {
                            stage("Run ${testName} Tests") {
                                sh "echo 'Executing ${testName} test suite on Linux node...'"
                                sleep 2 // Simulate complex testing work
                                sh "echo '✅ ${testName} tests PASSED'"
                            }
                        }
                    }
                    
                    // Execute the dynamically generated map of stages in parallel
                    parallel parallelTasks
                }
            }
        }
        
        stage('Milestone & Approval Gate') {
            when {
                expression { params.ENVIRONMENT == 'PROD' }
            }
            agent none 
            steps {
                // Milestone ensures that if a newer build reaches this point, older pending builds are cancelled
                milestone(1)
                
                timeout(time: 5, unit: 'MINUTES') {
                    input message: "Review the archived final_release_package.txt. Approve PROD Deployment?"
                }
                
                milestone(2)
            }
        }
        
        stage('Final Deployment') {
            agent { label 'linux' }
            steps {
                script {
                    logCustomStep("Deployment", "Deploying ${env.PROJECT_CODENAME} to ${params.ENVIRONMENT}...")
                }
                sh 'echo "Deployment Sequence Completed 100% Error-Free!"'
            }
        }
    }
    
    post {
        always {
            script {
                logCustomStep("Pipeline Status", "Execution complete. Beginning teardown.")
            }
        }
        success {
            echo "🏆 SUCCESS: The advanced multi-node data-transfer pipeline executed flawlessly!"
        }
        failure {
            echo "💥 FAILURE: An unexpected error occurred. Review the step logs."
        }
        aborted {
            echo "🛑 ABORTED: The pipeline was cancelled or timed out."
        }
    }
}
