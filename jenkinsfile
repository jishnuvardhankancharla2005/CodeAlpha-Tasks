pipeline {
    agent none
    stages {
        stage('Build on Windows') {
            agent { label 'windows' }
            steps {
                bat 'gradlew build'
            }
        }
        stage('Build on Linux') {
            agent { label 'linux' }
            steps {
                sh 'mvn clean install'
            }
        }
        stage('Test on Linux') {
            agent { label 'linux' }
            steps {
                sh './nodeHealth.sh'
            }
        }
    }
}
